+            }
+            self.scrollView.verticalScrollIndicatorInsets = UIEdgeInsets(top: environment.navigationHeight, left: 0.0, bottom: 0.0, right: 0.0)
+
+            if !self.didAppear {
+                self.didAppear = true
+                self.animateIn()
+            }
